{
  "opencollection": "1.0.0",
  "info": {
    "name": "Uber for Business Codes Orders API",
    "version": "1.2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Order Receipt",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.uber.com/v1.2/business/orders/:order_id/receipt",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the Eats order."
              }
            ]
          },
          "docs": "Get receipt information for an Uber Eats order within a business account."
        },
        {
          "info": {
            "name": "Get Order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.uber.com/v1.2/eats/orders/:order_id",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the order."
              }
            ]
          },
          "docs": "Returns order details for a specific order ID."
        },
        {
          "info": {
            "name": "Accept Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.uber.com/v1.2/eats/orders/:order_id/accept_pos_order",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the order."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Accept a pending order within the required acceptance window."
        },
        {
          "info": {
            "name": "Deny Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.uber.com/v1.2/eats/orders/:order_id/deny_pos_order",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the order."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deny a pending order and specify a reason."
        },
        {
          "info": {
            "name": "Cancel Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.uber.com/v1.2/eats/orders/:order_id/cancel",
            "params": [
              {
                "name": "order_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the order."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Cancel an accepted order."
        }
      ]
    }
  ],
  "bundled": true
}